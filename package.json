{
  "name": "dsh-openai-oauth",
  "version": "0.8.1",
  "description": "Codex integration for DeepSeek Harness: ChatGPT sign-in, web search, image generation and editing, persistent sessions, and usage tracking",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./runtime": {
      "types": "./lib/runtime.d.ts",
      "default": "./lib/runtime.js"
    },
    "./search": {
      "types": "./lib/component-search.d.ts",
      "default": "./lib/component-search.js"
    },
    "./fetch": {
      "types": "./lib/component-fetch.d.ts",
      "default": "./lib/component-fetch.js"
    },
    "./images": {
      "types": "./lib/component-images.d.ts",
      "default": "./lib/component-images.js"
    },
    "./account": {
      "types": "./lib/component-account.d.ts",
      "default": "./lib/component-account.js"
    },
    "./compaction": {
      "types": "./lib/codex-compaction.d.ts",
      "default": "./lib/codex-compaction.js"
    },
    "./context-indicator": {
      "types": "./lib/context-indicator.d.ts",
      "default": "./lib/context-indicator.js"
    },
    "./context": {
      "types": "./lib/context-policy.d.ts",
      "default": "./lib/context-policy.js"
    }
  },
  "bin": {
    "dsh-openai-oauth": "lib/global.js",
    "dsh-codex": "lib/global.js",
    "dsh-codex-login": "lib/login.js"
  },
  "files": [
    "lib",
    "assets",
    "guides",
    "cordis.patch.yml",
    "README.md",
    "README.ru.md",
    "README.zh-CN.md",
    "LICENSE",
    "scripts/repair-session-records.py"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/X1mper/dsh-openai-oauth.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config tsdown.client.config.ts",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "oauth"
  ],
  "license": "MIT",
  "dependencies": {
    "@openai/codex": "0.166.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-compaction": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-token-meter": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.5",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.24",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
